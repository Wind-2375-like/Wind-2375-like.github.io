---
---
<div class="pub">
  {% if site.enable_publication_thumbnails %}
    <div class="pub-aside">
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          {% assign entry_path = entry.preview %}
        {% else %}
          {% assign entry_path = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url %}
        {% endif %}
        <img class="pub-preview" src="{{ entry_path }}" alt="Figure from {{ entry.title | strip_html | escape }}" loading="lazy" data-zoomable>
      {% endif %}
      {% if entry.abbr %}
        <div class="pub-tag">{{ entry.abbr }}</div>
      {% endif %}
    </div>
  {% endif %}

  <!-- Entry bib key -->
  <div id="{{entry.key}}" class="pub-body">
    <!-- Title -->
    <div class="title">
      {% if entry.url %}
        <a href="{{ entry.url }}">{{ entry.title }}</a>
      {% else %}
        {{ entry.title }}
      {% endif %}
    </div>
    <!-- Author -->
    <div class="author">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_last_name = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {%- comment -%} `papers` limits a link to some bib keys, for different people with the same name {%- endcomment -%}
            {%- if coauthor.firstname contains author.first -%}
              {%- if coauthor.papers == null or coauthor.papers contains entry.key -%}
                {%- assign coauthor_url = coauthor.url -%}
                {%- break -%}
              {%- endif -%}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {% if forloop.first == false %},&nbsp;{% endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and&nbsp;{% endif -%}
        {% endif %}
        {%- if author_is_self -%}
          <strong class="self">
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{coauthor_url}}">
              {{- author.first }}
              {{ author.last -}}
            </a>
          {%- else -%}
            {{- author.first }}
            {{ author.last -}}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Venue -->
    {% if entry.venue %}
      {% assign venue = entry.venue %}
    {% elsif entry.type == 'article' %}
      {% capture venue %}{{ entry.journal }}, {{ entry.year }}{% endcapture %}
    {% elsif entry.booktitle %}
      {% capture venue %}{{ entry.booktitle }}, {{ entry.year }}{% endcapture %}
    {% else %}
      {% assign venue = entry.year %}
    {% endif %}
    <div class="periodical">
      <em>{{ venue | strip }}</em>
      {% if entry.award %}
        <span class="award">{{ entry.award }}</span>
      {% endif %}
    </div>

    {% if entry.tldr %}
      <div class="tldr">{{ entry.tldr }}</div>
    {% endif %}

    <!-- Links/Buttons -->
    <div class="links">
      {% if entry.abstract %}
        <a class="abstract btn btn-sm z-depth-0" role="button">Abstract</a>
      {% endif %}
      {% if entry.pdf %}
        {% if entry.pdf contains '://' %}
          <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% else %}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
        {% endif %}
      {% endif %}
      {% if entry.arxiv %}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
      {% endif %}
      {% if entry.code %}
        <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
      {% endif %}
      {% if entry.data %}
        <a href="{{ entry.data }}" class="btn btn-sm z-depth-0" role="button">Data</a>
      {% endif %}
      {% if entry.website %}
        <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
      {% endif %}
      {% if entry.talk %}
        <a href="{{ entry.talk }}" class="btn btn-sm z-depth-0" role="button">Talk</a>
      {% endif %}
      {% if entry.thread %}
        <a href="{{ entry.thread }}" class="btn btn-sm z-depth-0" role="button">Thread</a>
      {% endif %}
      {% if entry.slides %}
        {% if entry.slides contains '://' %}
          <a href="{{ entry.slides }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% else %}
          <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Slides</a>
        {% endif %}
      {% endif %}
      {% if entry.poster %}
        {% if entry.poster contains '://' %}
          <a href="{{ entry.poster }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% else %}
          <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">Poster</a>
        {% endif %}
      {% endif %}
      {% if entry.bibtex_show %}
        <a class="bibtex btn btn-sm z-depth-0" role="button">BibTeX</a>
      {% endif %}
    </div>

    {% if entry.abstract %}
      <!-- Hidden abstract block -->
      <div class="abstract hidden">
        <p>{{ entry.abstract }}</p>
      </div>
    {% endif %}

    {% if entry.bibtex_show %}
      <!-- Hidden bibtex block -->
      <div class="bibtex hidden">
        {% highlight bibtex %}
        {{- entry.bibtex | hideCustomBibtex -}}
        {% endhighlight %}
      </div>
    {% endif %}
  </div>
</div>
