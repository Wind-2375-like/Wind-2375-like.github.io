---
layout: default
---
<div class="post home">
  <section class="intro">
    <div class="intro-bio">
      <header class="intro-header">
        <h1 class="post-title">
          <span class="font-weight-bold">{{ site.first_name }}</span>
          {{ site.last_name }}
          {% if page.native_name -%}
            <span class="native-name">({{ page.native_name }})</span>
          {%- endif %}
        </h1>
        {% if page.cv_pdf %}
          <a class="cv-link" href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}">CV</a>
        {% endif %}
      </header>
      <div class="intro-text">{{ content }}</div>
    </div>

    {% if page.profile %}
      <div class="intro-photo">
        {% if page.profile.image %}
          <img
            class="profile-img"
            src="{{ page.profile.image | prepend: 'assets/img/' | relative_url | bust_file_cache }}"
            alt="Photo of {{ site.first_name }} {{ site.last_name }}"
            width="180"
            height="180"
          >
        {% endif %}
        {% if page.social %}
          <div class="intro-social">{% include social.liquid %}</div>
        {% endif %}
        {% if page.profile.contact %}
          <div class="intro-contact">
            {% for line in page.profile.contact -%}
              <span>{{ line }}</span>
            {%- endfor %}
            <a href="mailto:{{ site.email | encode_email }}">{{ site.email }}</a>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if page.news and site.announcements.enabled %}
      <aside class="intro-news" aria-label="News">
        <div class="news-head">
          <h2 class="section-label">
            <a href="{{ '/news/' | relative_url }}">News</a>
          </h2>
          <button class="news-fold" type="button" aria-expanded="true" aria-controls="news-scroll" title="Hide news">
            <span aria-hidden="true">&rsaquo;</span><span class="sr-only">Hide news</span>
          </button>
        </div>
        <div class="news-scroll" id="news-scroll" tabindex="0">
          {% include news.liquid limit=true %}
        </div>
        <!-- Shown only while the column is folded: a thin strip on the right that brings it back -->
        <button class="news-unfold" type="button" aria-controls="news-scroll" title="Show news">
          <span aria-hidden="true">&lsaquo;</span><span class="news-unfold-label">News</span>
        </button>
      </aside>
    {% endif %}
  </section>

  {% if page.research %}
    {% include research.liquid %}
  {% endif %}

  {% if page.latest_posts %}
    <h2 class="section-label">
      <a href="{{ '/blog/' | relative_url }}">Latest Posts</a>
    </h2>
    {% include latest_posts.liquid %}
  {% endif %}
</div>

<script>
  (function () {
    var intro = document.querySelector('.intro');
    var box = document.querySelector('.news-scroll');
    if (!intro || !box) return;

    // Fade the bottom of the news list only while there is more to scroll.
    function updateFade() {
      box.classList.toggle('at-end', box.scrollTop + box.clientHeight >= box.scrollHeight - 4);
    }
    box.addEventListener('scroll', updateFade, { passive: true });
    window.addEventListener('resize', updateFade);

    // Fold the whole News column to the right; the bio and photo widen to fill the space.
    var fold = intro.querySelector('.news-fold');
    var unfold = intro.querySelector('.news-unfold');
    function setFolded(folded, remember) {
      intro.classList.toggle('news-folded', folded);
      fold.setAttribute('aria-expanded', folded ? 'false' : 'true');
      unfold.setAttribute('aria-expanded', folded ? 'false' : 'true');
      if (remember) {
        try {
          localStorage.setItem('newsFolded', folded ? '1' : '0');
        } catch (e) {}
      }
      updateFade();
    }
    // Keep keyboard focus on the visible toggle (detail is 0 for keyboard-activated clicks).
    fold.addEventListener('click', function (e) {
      setFolded(true, true);
      if (e.detail === 0) unfold.focus();
    });
    unfold.addEventListener('click', function (e) {
      setFolded(false, true);
      if (e.detail === 0) fold.focus();
    });
    var saved = null;
    try {
      saved = localStorage.getItem('newsFolded');
    } catch (e) {}
    setFolded(saved === '1', false);
  })();
</script>
